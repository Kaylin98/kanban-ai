# Copy to .env and fill in. Never commit .env.

# Sign-in. Generate the hash with: uv run scripts/hash_password.py
APP_USERNAME=your-username
APP_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$replace-with-output-of-hash_password
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace-with-a-long-random-string

# AI assistant (chat returns 502 without a key)
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# development (default) or production. Production sets Secure cookies, hides the API docs
# and trusts the X-Forwarded-For entry added by Render's proxy.
ENV=development

# Optional
# PORT=8000
# DATABASE_PATH=/app/data/pm.db
# STATIC_DIR=/app/frontend/out
